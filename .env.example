# Copy to .env for Docker Compose. For local execution export these variables.
GROUP_ID=1306
GROUP_NAME=2023-ФУТ-УпрК-1б
TIMEZONE=Europe/Moscow
# Reference Monday for alternating weeks, YYYY-MM-DD.
WEEK_ANCHOR=2025-09-01
WEEK_ANCHOR_TYPE=upper
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s
STARTUP_TIMEOUT=2m
BOOTSTRAP_WEEKS=2
WATCH_WEEKS=2
WATCH_INTERVAL=24h
CONFIRMATION_DELAY=10m
# Large removals require the same result to persist for longer.
MAJOR_CHANGE_CONFIRMATION_DELAY=30m
DELIVERY_POLL_INTERVAL=5s
# Exams are refreshed independently; commands always read their PostgreSQL cache.
EXAM_INTERVAL=24h
# Optional Moscow-time reminders. Both are disabled unless explicitly enabled.
REMINDER_TOMORROW_ENABLED=false
REMINDER_WEEKLY_ENABLED=false
REMINDER_POLL_INTERVAL=1m
# Optional URL/keyword DSN for local PostgreSQL; empty means standard PG* variables.
DATABASE_URL=
# Token from BotFather. TELEGRAM_CHAT_ID optionally enables one group/supergroup;
# private chats are always accepted.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional forum topic. Requires TELEGRAM_CHAT_ID.
TELEGRAM_THREAD_ID=
POSTGRES_USER=lunara
POSTGRES_DB=lunara
POSTGRES_PASSWORD=
