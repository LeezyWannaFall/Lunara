# Copy to .env for Docker Compose. For local execution export these variables.
GROUP_ID=1306
TIMEZONE=Europe/Moscow
# Reference Monday for alternating weeks, YYYY-MM-DD.
WEEK_ANCHOR=2025-09-01
WEEK_ANCHOR_TYPE=upper
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=20s
STARTUP_TIMEOUT=2m
BOOTSTRAP_WEEKS=2
# Optional URL/keyword DSN for local PostgreSQL; empty means standard PG* variables.
DATABASE_URL=
# Reserved for Telegram stage.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
POSTGRES_USER=lunara
POSTGRES_DB=lunara
POSTGRES_PASSWORD=
